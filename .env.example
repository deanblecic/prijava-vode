# Kopirajte u .env i promijenite vrijednosti.
DJANGO_SECRET_KEY=promijenite-u-dugi-nasumicni-niz
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=65.108.144.242,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://65.108.144.242
POSTGRES_DB=voda
POSTGRES_USER=voda
POSTGRES_PASSWORD=promijenite-lozinku
PRAG_SUMNJIVE_RAZLIKE=3

# E-pošta: link za zaboravljenu lozinku, podsjetnici suvlasnicima i popis neočitanih administratoru.
# Gmail: lozinka aplikacije (Google račun → Sigurnost → Potvrda u dva koraka → Lozinke aplikacija).
# Brevo: EMAIL_HOST=smtp-relay.brevo.com, korisnik i SMTP ključ iz Brevo postavki.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=vas.racun@gmail.com
EMAIL_HOST_PASSWORD=lozinka-aplikacije
DEFAULT_FROM_EMAIL=Očitanja vodomjera <vas.racun@gmail.com>
# Poruke iz obrasca „Kontaktirajte nas” na javnoj stranici (zadano: ocitanje-vode@gmail.com).
KONTAKT_EMAIL=ocitanje-vode@gmail.com
# Za port 465 umjesto 587:
# EMAIL_USE_SSL=1

# Zaboravljena lozinka: link vrijedi sekundi; najviše zahtjeva na sat po adresi i po IP-u.
# RESET_LOZINKE_SEKUNDI=3600
# RESET_LOZINKE_PO_ADRESI=3
# RESET_LOZINKE_PO_IP=10
